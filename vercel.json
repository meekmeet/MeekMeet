{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "meek-meet/.next",
  "framework": "nextjs",
  "installCommand": "npm install --workspaces",
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/handbook-dispatch",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/trigger-news-questions",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/meeting-lifecycle",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/marketing-drip",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/marketing-drip",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/marketing-drip",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/marketing-drip",
      "schedule": "30 23 * * *"
    },
    {
      "path": "/api/leader-reminders",
      "schedule": "*/15 * * * *"
    }
  ]
}
