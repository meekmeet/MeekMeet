# Meek Meet Web Environment Template
# Copy this file to .env.local and fill in your actual values.
# See GETTING_KEYS.md for instructions on obtaining each value.
# Never commit .env.local to version control.

# Supabase Configuration (new key system)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
SUPABASE_SECRET_KEY=<your-secret-key>

# Email
RESEND_API_KEY=<your-resend-api-key>

# Cron protection (generate a strong random string)
CRON_SECRET=<generate-a-secure-random-string>

# AI synthesis & question generation (Groq)
GROQ_API_KEY=<your-groq-api-key>

# Optional: geocoding circle locations (Google Cloud Console)
GOOGLE_MAPS_API_KEY=<your-google-maps-api-key>

# Optional: daily news-driven questions (NewsAPI)
NEWS_API_KEY=<your-newsapi-key>

# Optional: error monitoring (Sentry). Without a DSN the SDK stays inert.
# Browser SDK needs the NEXT_PUBLIC_ variant; server uses the same DSN.
NEXT_PUBLIC_SENTRY_DSN=<your-sentry-dsn>
# Optional: performance tracing sample rate (0-1). Defaults to 0 (tracing off).
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Optional: API rate limit tuning (requests per minute per client IP).
# Sensible defaults are baked in; only set these to override.
# RATE_LIMIT_UPLOAD_PER_MINUTE=10
# RATE_LIMIT_CIRCLE_ORGANIZER_PER_MINUTE=30
# RATE_LIMIT_CRON_PER_MINUTE=30
# RATE_LIMIT_PUBLIC_INSIGHTS_PER_MINUTE=120
# RATE_LIMIT_AUTH_CALLBACK_PER_MINUTE=60
